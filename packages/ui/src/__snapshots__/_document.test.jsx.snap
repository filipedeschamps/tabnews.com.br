// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ui > _document > renders correctly 1`] = `
<mockroot>
  <main
    data-testid="Next App Content"
  />
  <script
    id="theme"
    strategy="beforeInteractive"
  >
    var m=localStorage.getItem('colorMode');
if(['auto','night','dark','day','light'].includes(m))document.documentElement.setAttribute('data-no-flash',m)
  </script>
  <script
    data-testid="Next Scripts"
  />
</mockroot>
`;
