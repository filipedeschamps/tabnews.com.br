{
  "name": "@tabnews/forms",
  "version": "4.0.0",
  "description": "TabNews useForm hook and form validators",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "sideEffects": false,
  "files": [
    "src",
    "!src/**/*.test.js"
  ],
  "scripts": {
    "test": "vitest --root ../.. watch \"$PWD\"",
    "test:run": "vitest --root ../.. run \"$PWD\"",
    "lint": "eslint . && prettier --check .",
    "format": "eslint --fix . && prettier --write ."
  },
  "dependencies": {
    "validation-br": "^2.0.0"
  },
  "peerDependencies": {
    "@tabnews/helpers": ">=4.0.0",
    "@tabnews/hooks": ">=4.0.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "author": "TabNews",
  "repository": {
    "type": "git",
    "url": "https://github.com/filipedeschamps/tabnews.com.br",
    "directory": "packages/forms"
  },
  "keywords": [
    "tabnews",
    "form",
    "hook",
    "validator"
  ],
  "publishConfig": {
    "access": "public"
  }
}
